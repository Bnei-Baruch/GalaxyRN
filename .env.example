# Copy to .env (gitignored) and fill in. Only the E2E_* keys are used by the
# on-device verification harness (scripts/device-verify.sh + .maestro flows).
# Other app env vars (AUTH_CONFIG_*, SENTRY_DSN, etc.) are documented elsewhere.

# Test account used by .maestro/login.yaml for automated Keycloak login.
E2E_USERNAME=
E2E_PASSWORD=

# Two Wi-Fi networks for the Wi-Fi->Wi-Fi handoff test
# (scripts/device-verify.sh net wifi-switch a|b). Both APs must be in range.
E2E_WIFI_A_SSID=
E2E_WIFI_A_PASS=
E2E_WIFI_B_SSID=
E2E_WIFI_B_PASS=
