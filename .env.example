# Copy to .env (gitignored) and fill in real values.
# This is the single env template for the project: app config (react-native-dotenv, read via
# `@env`) + the E2E_* keys used by the on-device test harness (scripts/device-verify.sh + .maestro).
# Values below are placeholders/mocks — replace with real ones in your local .env.

# --- App identifiers ---
GOOGLE_PLAY_ID=com.yourappmock
APP_STORE_ID=9876543210

# --- Backend services ---
API_BACKEND=https://api.example.com/mock
STRDB_BACKEND=https://storage.example.com/
STUDY_MATERIALS=https://content.example.com/api/units
QST_BACKEND=https://questions.example.com/api
GEO_IP_INFO=https://geoip.example.com

# --- Authentication (Keycloak) ---
AUTH_CONFIG_ISSUER=https://auth.example.com/realms/mock
ACCOUNT_URL=https://auth.example.com/realms/mock/account

# --- Messaging / WebRTC ---
MQTT_URL=mqtt.example.com
MSG_URL=msg.example.com
STUN_SRV_GXY=stun:stun.example.com:3478

# --- Monitoring (Sentry) ---
SENTRY_DSN=https://00000000000000000000000000000000@sentry.example.com/0
SENTRY_LEVEL=debug
SENTRY_AUTH_TOKEN=sntrys_mocktoken123456789mocktoken123456789mocktoken123456789mocktoken123456789
SENTRY_ORG=mockorg
SENTRY_PROJECT=mock-mobile

# --- Customer support ---
CRISP_WEBSITE_ID=00000000-0000-0000-0000-000000000000
SUPPORT_EMAIL=email@gmail.com

# =====================================================================
# E2E test harness (scripts/device-verify.sh + .maestro flows). Only the
# E2E_* keys are read by the harness; the app itself ignores them.
# =====================================================================

# Test account used by .maestro/login.yaml for automated Keycloak login.
E2E_USERNAME=
E2E_PASSWORD=

# Exact room description (as shown in the room list) that the test account can join.
# Required by the in-room flows: chat.yaml / rejoin.yaml / audio-device.yaml.
E2E_ROOM=

# Two Wi-Fi networks for the Wi-Fi->Wi-Fi handoff test
# (scripts/device-verify.sh net wifi-switch a|b). Both APs must be in range.
E2E_WIFI_A_SSID=
E2E_WIFI_A_PASS=
E2E_WIFI_B_SSID=
E2E_WIFI_B_PASS=
