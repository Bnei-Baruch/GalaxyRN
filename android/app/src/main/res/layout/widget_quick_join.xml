<?xml version="1.0" encoding="utf-8"?>
<!-- Default visibilities match the "no room" state (also the picker preview);
     GxyWidgetProvider.buildViews sets them per state.
     The cell is usually taller than the content: the card wraps it and is
     centered, so the background has no empty bands above and below. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_background"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/arvut_round" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_room"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_no_room"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/widget_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/widget_status_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot_not_in_room" />

                    <TextView
                        android:id="@+id/widget_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/widget_not_in_room"
                        android:textColor="#8A8F96"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_join"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/widget_join_background"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/widget_join"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/widget_btn_audio"
                style="@style/WidgetToggle">

                <ImageView
                    style="@style/WidgetToggleIcon"
                    android:src="@drawable/widget_ic_hearing" />

                <TextView
                    style="@style/WidgetToggleLabel"
                    android:text="@string/widget_audio_mode" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_btn_mic"
                style="@style/WidgetToggle">

                <ImageView
                    android:id="@+id/widget_btn_mic_icon"
                    style="@style/WidgetToggleIcon"
                    android:src="@drawable/widget_ic_mic" />

                <TextView
                    style="@style/WidgetToggleLabel"
                    android:text="@string/widget_mic" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_btn_cam"
                style="@style/WidgetToggle">

                <ImageView
                    android:id="@+id/widget_btn_cam_icon"
                    style="@style/WidgetToggleIcon"
                    android:src="@drawable/widget_ic_video_camera_front" />

                <TextView
                    style="@style/WidgetToggleLabel"
                    android:text="@string/widget_camera" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_btn_open"
                style="@style/WidgetToggle"
                android:background="@drawable/widget_toggle_off">

                <ImageView
                    style="@style/WidgetToggleIcon"
                    android:src="@drawable/widget_ic_open" />

                <TextView
                    style="@style/WidgetToggleLabel"
                    android:text="@string/widget_open" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
